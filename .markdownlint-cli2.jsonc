{
  "config": {
    "default": true,
    // Prose is written one paragraph per line.
    "MD013": false,
    // Older posts end lines with 4+ trailing spaces to force a line break; stripping them changes the rendered page.
    "MD009": false,
    // List marker spacing, bullet character and table pipe spacing are style only and render the same.
    "MD030": false,
    "MD004": false,
    "MD060": false,
    // Link wording is the author's text (e.g. "[here]" in older posts).
    "MD059": false,
    // The post title lives in frontmatter, so the body starts with text or ## headings.
    "MD041": false,
    "MD033": { "allowed_elements": ["del", "div", "span", "br", "sup", "sub", "kbd"] }
  },
  "globs": ["**/*.md"],
  "ignores": ["node_modules/**", "dist/**", ".astro/**"]
}
