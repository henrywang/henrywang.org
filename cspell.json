{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en",
  "dictionaryDefinitions": [
    { "name": "project-words", "path": "./project-words.txt", "addWords": true }
  ],
  "dictionaries": ["project-words"],
  "ignorePaths": [
    "node_modules/**",
    "dist/**",
    ".astro/**",
    "pnpm-lock.yaml",
    "LICENSE*",
    "public/**",
    "project-words.txt"
  ],
  "patterns": [
    { "name": "fenced-code", "pattern": "/^\\s*(```|~~~)[\\s\\S]*?^\\s*\\1/gm" }
  ],
  "languageSettings": [
    { "languageId": "markdown", "ignoreRegExpList": ["fenced-code"] }
  ]
}
