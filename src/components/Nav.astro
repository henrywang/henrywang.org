---
import { SITE } from '../consts';
import { type Lang, t, path } from '../i18n';
interface Props { lang: Lang; altHref: string }
const { lang, altHref } = Astro.props;
const s = t(lang);
const p = Astro.url.pathname.replace(/^\/zh(?=\/|$)/, '') || '/';
const links = [
  { href: path(lang, '/'), label: s.writing, active: p === '/' || p.startsWith('/blog') || p.startsWith('/tags') },
  { href: path(lang, '/archive/'), label: s.archive, active: p.startsWith('/archive') },
  { href: path(lang, '/about/'), label: s.about, active: p.startsWith('/about') },
];
---
<nav class="nav">
  <a href={path(lang, '/')} class="brand"><span class="mark">H</span><b>{SITE.title}</b></a>
  <div class="links">
    {links.map((l) => <a href={l.href} aria-current={l.active ? 'page' : undefined}>{l.label}</a>)}
  </div>
  <div class="tools">
    <button class="theme" type="button" aria-label={s.toDark} title={s.toDark} data-to-light={s.toLight} data-to-dark={s.toDark}>
      <span class="i-sun"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg></span><span class="i-moon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path></svg></span>
    </button>
    <a href={path(lang, '/rss.xml')} class="rss">RSS</a>
  </div>
</nav>
<style>
  .nav { position: sticky; top: 0; z-index: 40; display: flex; align-items: center; gap: 24px; padding: 0 var(--gutter); height: 60px; background: var(--nav-bg); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border-bottom: 1px solid var(--hairline); }
  .brand { display: flex; align-items: center; gap: 9px; color: inherit; }
  .brand b { font-size: 16px; font-weight: 700; letter-spacing: -.01em; }
  .mark { width: 26px; height: 26px; border-radius: 8px; background: #C15F3C; display: flex; align-items: center; justify-content: center; color: #FAF9F5; font-family: var(--serif); font-weight: 500; font-size: 17px; line-height: 1; }
  .links { display: flex; gap: 22px; flex: 1; }
  .links a { font-size: 14.5px; font-weight: 500; color: var(--muted); }
  .links a:hover, .links a[aria-current] { color: var(--accent); }
  .tools { display: flex; align-items: center; gap: 8px; }
  .theme { cursor: pointer; width: 34px; height: 32px; display: flex; align-items: center; justify-content: center; border-radius: 8px; border: 1px solid var(--border); background: var(--surface); color: var(--muted); padding: 0; }
  .theme:hover { color: var(--accent); }
  .theme span { line-height: 0; }
  .i-sun { display: none; }
  :global(html[data-theme="dark"]) .i-moon { display: none; }
  :global(html[data-theme="dark"]) .i-sun { display: block; }
  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme="light"])) .i-moon { display: none; }
    :global(html:not([data-theme="light"])) .i-sun { display: block; }
  }
  .rss { font-size: 13.5px; font-weight: 600; color: var(--muted); border: 1px solid var(--border); border-radius: 8px; padding: 6px 11px; background: var(--surface); }
  .rss:hover { color: var(--accent); }
  @media (max-width: 640px) { .brand b, .rss { display: none; } .nav { gap: 16px; } .links { gap: 16px; } }
</style>
<script>
  const btn = document.querySelector<HTMLButtonElement>('.theme')!;
  const root = document.documentElement;
  const mq = matchMedia('(prefers-color-scheme: dark)');
  const isDark = () => root.dataset.theme === 'dark' || (root.dataset.theme !== 'light' && mq.matches);
  const label = () => { btn.title = btn.ariaLabel = (isDark() ? btn.dataset.toLight : btn.dataset.toDark) ?? ''; };
  btn.addEventListener('click', () => {
    const next = isDark() ? 'light' : 'dark';
    localStorage.setItem('theme', next);
    root.dataset.theme = next;
    root.style.colorScheme = next;
    label();
  });
  mq.addEventListener('change', label);
  label();
</script>
