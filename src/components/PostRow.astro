---
import TagChip from './TagChip.astro';
import { formatDate, readingTime, postUrl, htmlLang, type Post } from '../utils';
interface Props { post: Post; hasTranslation?: boolean }
const { post, hasTranslation } = Astro.props;
const { lang } = post.data;
---
<a href={postUrl(post)} class="row">
  <div class="meta">
    {post.data.tags[0] && <TagChip tag={post.data.tags[0]} lang="en" link={false} />}
    <span>{formatDate(post.data.pubDate)} · {readingTime(post.body, lang)} min read</span>
    {hasTranslation ? <span class="badge">EN · <span lang="zh-CN">中文</span></span> : lang === 'zh' && <span class="badge" lang="zh-CN">中文</span>}
  </div>
  <h2 lang={htmlLang(lang)}>{post.data.title}</h2>
  <p lang={htmlLang(lang)}>{post.data.description}</p>
</a>
<style>
  .row { display: block; padding: 24px 0; border-bottom: 1px solid var(--border-soft); color: inherit; }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; font-size: 13px; color: var(--muted); margin-bottom: 8px; }
  .badge { font-size: 12px; font-weight: 600; border: 1px solid var(--border); border-radius: 5px; padding: 1px 7px; }
  h2 { margin: 0 0 6px; font-family: var(--serif); font-size: 23px; font-weight: 500; letter-spacing: -.005em; line-height: 1.35; text-wrap: pretty; transition: color .15s; }
  .row:hover h2 { color: var(--accent); }
  p { margin: 0; font-size: 15px; line-height: 1.6; color: var(--muted); max-width: 64ch; text-wrap: pretty; }
  h2:lang(zh) { font-family: var(--zh); font-weight: 600; letter-spacing: .01em; }
  p:lang(zh) { line-height: 1.8; }
</style>
