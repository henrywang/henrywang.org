---
import Base from '../layouts/Base.astro';
import TagFilter from '../components/TagFilter.astro';
import PostRow from '../components/PostRow.astro';
import { getPosts, getTranslation } from '../utils';
import { SITE } from '../consts';
import { type Lang, t, path } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const posts = (await getPosts()).slice(0, SITE.postsOnHome);
const rows = await Promise.all(posts.map(async (post) => ({ post, hasTranslation: !!(await getTranslation(post)) })));
---
<Base lang={lang}>
  <div class="container">
    <header class="intro">
      <img src="/images/henry.jpg" alt="" class="avatar" width="56" height="56" />
      <div>
        <h1>Hi, I'm Henry Wang. I'm a Quality Engineer who makes apps for the Mac and iPhone and works on Linux.</h1>
        <p>I've used a Mac for 16 years and Linux for 10. I work at LSEG, worked at Red Hat before that, build <a href="https://berthly.net">Berthly</a> on the side, and maintain <a href="https://github.com/bootc-dev/bootc">bootc</a>. I write here about software, design, travel and books.</p>
      </div>
    </header>
    <TagFilter lang={lang} />
    <div class="list">{rows.map((r) => <PostRow post={r.post} hasTranslation={r.hasTranslation} />)}</div>
    <div class="more"><a href={path(lang, '/archive/')}>{t(lang).everything}</a></div>
  </div>
</Base>
<style>
  .intro { display: flex; align-items: flex-start; gap: 20px; margin-bottom: 44px; }
  .avatar { width: 56px; height: 56px; }
  h1 { margin: 0 0 10px; font-family: var(--serif); font-size: clamp(28px, 4vw, 38px); font-weight: 500; letter-spacing: -.012em; line-height: 1.15; text-wrap: pretty; }
  .intro p { margin: 0; font-size: 17px; line-height: 1.6; color: var(--muted); max-width: 58ch; text-wrap: pretty; }
  .list { display: flex; flex-direction: column; }
  .more { margin-top: 28px; display: flex; justify-content: flex-end; font-size: 14.5px; font-weight: 600; }
  @media (max-width: 560px) { .avatar { display: none; } }
</style>
